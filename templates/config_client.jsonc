{
    "log_level": "info",

    "gui": {
        "enabled": true,
        "listen": "127.0.0.1:9090" // 客户端建议只监听本地
    },

    "inbounds": [
        // 1. 标准 SOCKS5 入站 (适合普通浏览器插件)
        {
            "type": "socks",
            "tag": "socks-in",
            "listen": "127.0.0.1",
            "port": 1080
        },
        // 2. HTTP/SOCKS 混合入站
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "127.0.0.1",
            "port": 1081
        },
        // 3. DNS 监听入站
        {
            "type": "dns",
            "tag": "dns-in",
            "listen": "127.0.0.1",
            "port": 53
        },
        // 4. v0.3.0 eBPF 透明代理入站 (Linux 5.9+ 独占，基于 BPF_PROG_TYPE_SK_LOOKUP)
        // 必须配合 advanced_dns 中的 fakeip 一起使用！
        {
            "type": "transparent",
            "tag": "transparent-in",
            "listen": "0.0.0.0",
            "port": 7895             // eBPF 会自动将命中 FakeIP 的网卡流量塞给该端口
        }
    ],

    "outbounds": [
        // 1. 核心幻影协议出站 (连接远端 Mirage 服务器)
        {
            "type": "mirage",
            "tag": "proxy-jp",
            "server": "203.0.113.1",
            "server_port": 443,
            "password": "your-secure-password",
            "camouflage_host": "www.apple.com", // 必须和服务端完全一致
            
            "pool_size": 16,                    // 多路复用连接池大小 (默认16)
            
            // 【硬核特性】TCP Brutal 参数 (需要服务端加载了 tcp-brutal.ko 内核模块)
            // v0.3.0 起已移除 brutal_rate_bps 别名，强制使用 mbps 单位防溢出！
            "brutal_rate_mbps": 100,            // 要求服务端固定发送速率为 100 Mbps
            "brutal_base_rtt_ms": 45            // 强指定网络物理延迟(ms)，留空则自适应测算
        },
        {
            "type": "mirage",
            "tag": "proxy-us",
            "server": "198.51.100.1",
            "server_port": 443,
            "password": "your-secure-password",
            "camouflage_host": "www.apple.com",
            "pool_size": 16
        },
        // 2. Urltest 出站 (高可用性/自动优选，v0.3 后续会接入 eBPF Socket RTT)
        {
            "type": "urltest",
            "tag": "auto-proxy",
            "outbounds": ["proxy-jp", "proxy-us"], // 被测速的子出站集合
            "url": "http://www.gstatic.com/generate_204", // 拨测地址
            "interval": 300,                       // 拨测间隔 (秒)
            "tolerance": 50,                       // 容忍度 (ms)：只要 RTT 差值在此范围内就不随意切换
            "test_type": "ping"                    // 探测类型：可选 "ping", "http"
        },
        // 3. Selector 出站 (手动选择出站/API 切换)
        {
            "type": "selector",
            "tag": "manual-proxy",
            "outbounds": ["auto-proxy", "proxy-jp", "proxy-us", "direct-out"]
        },
        // 4. LoadBalance 负载均衡组 (v0.6.7): 把连接**分摊**到多个健康成员 (urltest/fallback/
        //    selector 都是"选一个", 它是"分摊")。建议成员**同区域** (都美国/都日本), 否则出口国
        //    不一致会影响落地解锁; `mirage-rs test` 显 [国家码]、`import --group` 会告警混区域。
        {
            "type": "load_balance",
            "tag": "balance-jp",
            "outbounds": ["proxy-jp", "proxy-us"], // 分摊连接的成员集合
            "strategy": "round-robin",             // v1 仅支持 round-robin (每连接原子游标轮流)
            "url": "http://www.gstatic.com/generate_204", // 健康检查拨测地址
            "interval": 300                        // 健康检查间隔 (秒)
            // ⚠ round-robin 下同会话多连接可能落不同节点, 查 IP 一致性的站点受影响
        },
        // 5. 直连与拦截
        {
            "type": "direct",
            "tag": "direct-out"
        },
        {
            "type": "block",
            "tag": "block-out"
        }
    ],

    "routing": {
        "default_outbound": "manual-proxy", // 所有未匹配规则的流量全部走代理
        "rules": [
            // GEO 路由体系
            {
                "geosite": ["cn"],          // 大陆域名
                "outbound": "direct-out"    // 直连
            },
            {
                "geoip": ["cn", "private"], // 大陆 IP 及 局域网 IP
                "outbound": "direct-out"
            },
            // 后缀/正则/关键字路由
            {
                "domain_suffix": ["google.com", "github.com"],
                "outbound": "manual-proxy"
            },
            {
                "domain_keyword": ["ads", "tracker"],
                "outbound": "block-out"
            },
            // 多条件组合: 一条规则写多个字段默认 OR (任一命中); 显式 "mode": "and" 则**全部满足**
            // 才命中 (下例: 既是 netflix 域名、又落在美国 IP 才走负载均衡组)。mode 只认 or/and,
            // 拼错会被 `mirage-rs check` 拦下 (v0.6.9+ 起校验, 不再静默当 or)。
            {
                "mode": "and",
                "domain_suffix": ["netflix.com"],
                "geoip": ["us"],
                "outbound": "balance-jp"
            }
        ]
    },

    "advanced_dns": {
        // eBPF XDP 零拷贝 DNS 拦截网卡绑定 (v0.2.3+)
        // 配置后系统 DNS 查询将无需穿越 Linux 内核协议栈，直接在网卡驱动层实现毫秒级 Fake-IP 响应
        "xdp_interface": "eth0",
        
        "default": "remote-dns",

        // Fake-IP 透明代理引擎 (极速 DNS 响应的核心)
        "fakeip": {
            "enabled": true,
            "inet4_range": "198.18.0.0/16" // 映射分配的内网无害 IP 段
        },

        // eBPF DNS 结果 LRU 缓存
        "cache": {
            "enabled": true,
            "max_entries": 10000
        },

        // DNS 解析器定义
        "resolvers": [
            {
                "tag": "remote-dns",
                "address": "tcp://8.8.8.8:53",
                "via": "manual-proxy"      // 规定发往 8.8.8.8 的查询流必须从代理出站
            },
            {
                "tag": "local-dns",
                "address": "udp://223.5.5.5:53",
                "via": "direct-out"        // 规定发往阿里的查询流直连
            }
        ],

        // 未分类域名 (未命中任何 routing.rules 规则、本会走 default_outbound 的) 的自适应分类:
        // 先用国内 DNS 解析, 首个 A 记录经 GeoIP 判 —— 属 CN 则直连返回国内结果; 属海外则改
        // fake-IP 代理, 并把该域名按 TTL 学习标记为海外 (后续直接 fake-IP)。国内 DNS 是最终回落。
        // ⚠️ 仅作用于"未命中显式规则"的灰域名; 已知被封的域名请放进 routing.rules 明确代理,
        //    否则极少数 CN 段污染会让它被误判直连。不配 = 关闭 (未命中照旧走 default_outbound)。
        "auto_classify": {
            "enabled": true,
            "ttl": 1800,             // 学习到的"海外"标记存活秒 (默认 3600; 防 CDN geo-DNS 抖动永钉代理)
            "max_entries": 4096,     // 学习缓存容量上限 (纯内存, 默认 8192)
            // 国内解出 CN IP 时是否交叉校验 (防少数 CN 段污染误判直连)。off(默认)/async。
            // async = 立即返回国内答复(零延迟), 后台经隧道可信解析确认; 若可信判海外则标记该域名,
            //         下次走 fakeip (本次连接不受保护, 这是非阻塞的固有取舍)。
            "verify_cn": "async"
        }

        // 注: DNS 分流复用 routing.rules (direct→国内DNS / mirage→fake-IP / block→NXDOMAIN);
        //     旧的 advanced_dns.rules (match/use) 已移除 (从未实现)。
    },

    // 调优 / Geo 数据 (v0.4.3+ 多源下载; v0.6.7 节点区域判定也读这里的 geoip.dat)
    "tuning": {
        "geodata_dir": "/etc/mirage/geo",   // geo .dat 存放目录 (下载/热重载都在此)

        // 多源 Geo 下载: 每源独立 URL + via。下载后存为 <name>.dat, 路由规则引用
        // 形如 "geosite": ["cn"] 用默认库, 或 "geosite": ["loyalsoldier.dat:cn"] 指名库。
        // via: direct=直连拉 (客户端常用) / proxy=走本地 socks/mixed 入站 (国内服务器拉 GitHub 用)。
        "geo_sources": [
            {
                "name": "geosite",           // 域名规则库 → geosite.dat
                "kind": "geosite",
                "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat",
                "via": "direct"
            },
            {
                "name": "geoip",             // IP 段库 → geoip.dat (节点区域判定也用它)
                "kind": "geoip",
                "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat",
                "via": "direct"
            }
        ],
        "geo_update_days": 7                 // 每 7 天检查更新 (默认 7)

        // 服务端专用: "dns_tcp_resolver": "1.1.1.1" —— 出向 UDP 被封的 VPS 走 DNS-over-TCP 解析
        // 域名 (客户端通常不需要, 见 config_server.jsonc)。
    }
}
