{
    // 全局日志级别：可选 "trace", "debug", "info", "warn", "error"
    "log_level": "info",

    // 图形化监控 / 仪表盘配置 (Neon Pulse Dashboard)
    "gui": {
        "enabled": true,                // 开启高逼格仪表盘
        "listen": "0.0.0.0:9090"        // 仪表盘 Web 服务监听地址
    },

    // 入站配置：定义服务端如何接收客户端流量
    "inbounds": [
        {
            "type": "mirage_server",    // 服务端专属的 Mirage 协议入站
            "tag": "mirage-in",
            "listen": "0.0.0.0",        // 绑定到所有网卡
            "port": 443,                // 建议使用 443 伪装效果最好
            "password": "your-secure-password", // 必须与客户端保持绝对一致
            "camouflage_host": "www.apple.com"  // 必须与客户端一致，用于 TLS SNI 完美伪装，屏蔽主动探测
        }
    ],

    // 出站配置：服务端接收请求后，发往真实互联网的通道
    "outbounds": [
        {
            "type": "direct",           // 服务端通常直接出站
            "tag": "direct-out"
        },
        {
            "type": "block",            // 用于屏蔽恶意请求的出站
            "tag": "block-out"
        }
    ],

    // 路由配置：控制不同流量走向哪个出站
    "routing": {
        "default_outbound": "direct-out", // 默认放行所有流量
        "rules": [
            {
                // 可选配置：屏蔽一些高风险端口或内网 IP 扫描（防止服务端被当做跳板机）
                "port": [25, 465, 587],   // 屏蔽发件端口，防滥用
                "outbound": "block-out"
            },
            {
                // 使用 geosite 屏蔽特定类别的流量
                "geosite": ["category-ads", "category-porn"],
                "outbound": "block-out"
            }
        ]
    },

    // 调优 / Geo 数据 / DNS 解析
    "tuning": {
        "geodata_dir": "/etc/mirage/geo",   // geo .dat 存放目录

        // 多源 Geo 下载 (v0.4.3 起取代旧的 geosite_url/geoip_url 单字段)。服务端拉取用
        // via:"direct" (服务端无本地 socks 入站, 不能走 proxy)。名字即落盘 <name>.dat。
        "geo_sources": [
            {
                "name": "geosite",
                "kind": "geosite",
                "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat",
                "via": "direct"
            },
            {
                "name": "geoip",
                "kind": "geoip",
                "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat",
                "via": "direct"
            }
        ],
        "geo_update_days": 7,               // 每 7 天检查更新 (默认 7)

        // 【服务端专用, v0.6.5】出向 UDP 被封的 VPS: 域名解析改走 DNS-over-TCP (自实现无依赖),
        // 否则 glibc getaddrinfo 走 UDP 会解析不了代理目标域名。无端口默认 :53。不设=系统解析器。
        "dns_tcp_resolver": "1.1.1.1"

        // ebpf_mode 默认 auto: 服务端自动跳过 eBPF (入站是加密流, sockmap/XDP/sk_lookup
        // 对服务端都无价值)。调试才设 "force"。
    }
}
