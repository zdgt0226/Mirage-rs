  "meta": {
    "title": "Mirage-rs 连接处理与路由判定",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "ingress", "label": "接入 Ingress" },
    { "id": "routing", "label": "路由判定 Routing" },
    { "id": "egress", "label": "限速与出站 Egress" }
  ],
  "phases": [
    { "id": "accept", "label": "接入 + 取目标", "fromCol": 0, "toCol": 2 },
    { "id": "decide", "label": "判定", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "out", "label": "限速 + 出站", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["src", "inbound", "resolve", "rules", "ratelimit", "dispatch"],
  "nodes": [
    { "id": "src", "lane": "ingress", "col": 0, "type": "external", "label": "来源", "sublabel": "LAN 设备 / 本地应用", "width": 138 },
    { "id": "inbound", "lane": "ingress", "col": 1, "type": "frontend", "label": "入站接入", "sublabel": "transparent(eBPF) / SOCKS·mixed", "tag": "sk_lookup·tc_divert", "width": 150 },
    { "id": "resolve", "lane": "ingress", "col": 2, "type": "backend", "label": "取目标", "sublabel": "fake-IP 反查 / SNI 嗅探", "width": 138 },
    { "id": "devprof", "lane": "routing", "col": 2, "type": "security", "label": "device_profile", "sublabel": "源 IP → 策略档 + 限速", "width": 140 },
