    { "id": "ratelimit", "lane": "egress", "col": 4, "type": "messagebus", "label": "限速", "sublabel": "TCP 整形 / UDP policing", "tag": "device_profiles kbps", "width": 144 },
    { "id": "dispatch", "lane": "egress", "col": 5, "type": "cloud", "label": "出站分派", "sublabel": "direct·mirage·WG·SS", "width": 144 }
