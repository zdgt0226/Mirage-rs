  "edges": [
    { "id": "e-src", "from": "src", "to": "inbound", "variant": "default" },
    { "id": "e-in-res", "from": "inbound", "to": "resolve", "variant": "default" },
    { "id": "e-in-dev", "from": "inbound", "to": "devprof", "label": "源 IP", "variant": "dashed", "role": "branch" },
    { "id": "e-res-rules", "from": "resolve", "to": "rules", "label": "目标域名/IP", "variant": "emphasis" },
    { "id": "e-dev-rules", "from": "devprof", "to": "rules", "label": "策略档规则", "variant": "dashed", "role": "branch" },
    { "id": "e-rules-rl", "from": "rules", "to": "ratelimit", "label": "选定出站 tag", "variant": "emphasis" },
    { "id": "e-dev-rl", "from": "devprof", "to": "ratelimit", "label": "rate_limit_kbps", "variant": "dashed", "role": "branch" },
    { "id": "e-rl-out", "from": "ratelimit", "to": "dispatch", "variant": "emphasis" },
    { "id": "e-rules-cls", "from": "rules", "to": "classify", "label": "未命中", "variant": "default", "role": "branch" },
    { "id": "e-cls-out", "from": "classify", "to": "dispatch", "label": "回落出站", "variant": "dashed", "role": "branch" },
    { "id": "e-rules-block", "from": "rules", "to": "block", "label": "block 规则", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "判定优先级",
      "items": [
        "device_profile: 源 IP → 选策略档 + 限速档",
        "规则引擎: domain/geosite/IP/geoip/process/source 维度, config 顺序首个命中",
        "未命中 → auto_classify (CN 直连 / 海外 fake-IP) → default_outbound 兜底"
      ]
    },
    {
      "dot": "amber",
      "title": "出站与限速",
      "items": [
        "direct: splice(2) 零拷贝直连快路径",
        "mirage: fake-TLS ClientHello 仿真 + ChaCha20/AES-GCM AEAD 暖池隧道",
        "WireGuard / Shadowsocks 上游中转; block 丢弃",
        "限速复用 device_profiles: TCP 整形(背压) / UDP policing(丢包)"
      ]
    }
  ]
}
